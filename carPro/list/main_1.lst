    7          /*************  功能说明  **************
    8          高级PWM定时器 PWM5,PWM6,PWM7,PWM8 每个通道都可独立实现PWM输出.
    9          4个通道PWM根据需要设置对应输出口，可通过示波器观察输出的信号.
   10          PWM周期和占空比可以自定义设置，最高可达65535.
   11          下载时, 选择时钟 24MHZ (用户可在"config.h"修改频率).
   12          ******************************************/
   13          sbit AIN1=P4^5;
   14          sbit AIN2=P2^7;
   15          sbit BIN1=P2^5;
   16          sbit BIN2=P2^6;
   17          sbit zuo2=P0^3;
   18          sbit zuo1=P0^4;
   19          sbit zhong=P0^2;
   20          sbit you1=P0^1;
   21          sbit you2=P0^0;
   22          sbit LED1=P4^1;
   23          sbit LED2=P4^2;
   24          sbit LED3=P4^4;
   25          
   26          PWMx_Duty PWMB_Duty;
