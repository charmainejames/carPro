  129          
  130          // 限幅：把速度约束到 [0, MAX_SPEED]
  131          int Clamp(int v)
  132          {
  133   1              if (v < 0)          return 0;
  134   1              if (v > MAX_SPEED)  return MAX_SPEED;
  135   1              return v;
  136   1      }
  137          
  138          // 启动地板：电机有死区，占空比太低只会嗡嗡不转。
  139          // 把 (0, MIN_DRIVE) 之间的小速度抬到 MIN_DRIVE；真正要停的 0 保持 0。
  140          int Floor(int v)
  141          {
  142   1              if (v > 0 && v < MIN_DRIVE)  return MIN_DRIVE;
  143   1              return v;
  144   1      }
  145          
  146          // 计算线偏差。返回值范围约 -4(线在最左) ~ +4(线在最右)，0=居中。
  147          // 传感器：读到 0 = 压黑线(在线上)，1 = 白底。物理排列 左→右：zuo1 zuo2 zhong yo
             -u1 you2
  148          int Track_GetError(void)
  149          {
  150   1              int s_l1, s_l2, s_m, s_r1, s_r2;   // 压线=1，白底=0
  151   1              int cnt, sum;
  152   1      
  153   1              s_l1 = ON_LINE(zuo1);    // 最左   P0.4
  154   1              s_l2 = ON_LINE(zuo2);    // 次左   P0.3
  155   1              s_m  = ON_LINE(zhong);   // 中     P0.2
  156   1              s_r1 = ON_LINE(you1);    // 次右   P0.1
  157   1              s_r2 = ON_LINE(you2);    // 最右   P0.0
  158   1      
  159   1              cnt = s_l1 + s_l2 + s_m + s_r1 + s_r2;          // 压线的传感器个数
  160   1              sum = s_l1*(-4) + s_l2*(-2) + s_m*0 + s_r1*(+2) + s_r2*(+4);  // 位置加权和
  161   1      
  162   1              if (cnt == 0)        // 全白脱线 → 不更新记忆，靠上次方向找回（在主循环里处理
             -）
  163   1                      return last_error;
  164   1      
  165   1              if (cnt >= 5)        // 全黑(十字/路口) → 直行通过
  166   1              {
  167   2                      last_error = 0;
  168   2                      return 0;
  169   2              }
  170   1      
  171   1              last_error = (sum / cnt) * DIR_SIGN;            // 归一化偏差 + 左右纠正
  172   1              return last_error;
  173   1      }
