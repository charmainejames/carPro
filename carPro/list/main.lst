  113          // 带方向的差速驱动：left/right 取值 -100~100，正=前进，负=反转。
  114          // 实测左右接反，已对调：逻辑左轮=电机A(AIN/PWM5)，逻辑右轮=电机B(BIN/PWM6)。
  115          void Motor_Drive(int left, int right)
  116          {
  117   1              // 逻辑左轮 → 电机A 方向
  118   1              if (left >= 0) { AIN1=0; AIN2=1; }          // 前进
  119   1              else           { AIN1=1; AIN2=0; left=-left; }  // 反转
  120   1              // 逻辑右轮 → 电机B 方向
  121   1              if (right >= 0){ BIN1=1; BIN2=0; }          // 前进
  122   1              else           { BIN1=0; BIN2=1; right=-right; } // 反转
  123   1      
  124   1              // PWM_Run(pwm1=PWM6=电机B, pwm2=PWM5=电机A)，所以这里参数也要交换
  125   1              PWM_Run(right, left);
  126   1      }
