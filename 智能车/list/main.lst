  319          u8 ReadTrackSensors(void)
  320          {
  321   1              /* 读取5路循迹：最左/次左/中/次右/最右，组合成bit掩码 */
  322   1              u8 mask;
  323   1              mask = 0;
  324   1              if(zuo2 == LINE_ON)  mask |= MASK_ZUO2;
  325   1              if(zuo1 == LINE_ON)  mask |= MASK_ZUO1;
  326   1              if(zhong == LINE_ON) mask |= MASK_ZHONG;
  327   1              if(you1 == LINE_ON)  mask |= MASK_YOU1;
  328   1              if(you2 == LINE_ON)  mask |= MASK_YOU2;
  329   1              return mask;
  330   1      }
  331          
  332          u8 CountBits(u8 mask)
  333          {
  334   1              u8 count;
  335   1              count = 0;
  336   1              if(mask & MASK_ZUO2)  count++;
  337   1              if(mask & MASK_ZUO1)  count++;
  338   1              if(mask & MASK_ZHONG) count++;
  339   1              if(mask & MASK_YOU1)  count++;
  340   1              if(mask & MASK_YOU2)  count++;
  341   1              return count;
  342   1      }
  343          
  344          /* 位置加权算偏差：5路按位置加权(×10放大避免整数除法丢精度)，再除以压线�
             -�。
  345             返回约 -40(线最左) ~ +40(线最右)，0=居中。连续量，供PD用。 */
  346          int Track_GetError(u8 mask)
  347          {
  348   1              int sum = 0;
  349   1              u8 cnt = 0;
  350   1      
  351   1              if(mask & MASK_ZUO2) { sum += -40; cnt++; }   /* 最左 */
  352   1              if(mask & MASK_ZUO1) { sum += -20; cnt++; }   /* 次左 */
  353   1              if(mask & MASK_ZHONG){ sum +=   0; cnt++; }   /* 中   */
  354   1              if(mask & MASK_YOU1) { sum +=  20; cnt++; }   /* 次右 */
  355   1              if(mask & MASK_YOU2) { sum +=  40; cnt++; }   /* 最右 */
  356   1      
  357   1              if(cnt == 0) return 0;
  358   1              return (sum / cnt) * DIR;
  359   1      }
