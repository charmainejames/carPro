   64          /* ===== 巡线参数（5路灰度，压黑线为1）— PD比例控制 =====
   65             调参口诀（一次只动一个）：
   66             - 画龙/抖：先加 KD（治画龙主力），再降 BASE_PWM。
   67             - 转弯不够/冲出：加 KP。
   68             - 越修越偏/反向追线：DIR 改 -1。
   69          */
   70          #define LINE_ON             1       /* 传感器有效电平：压黑线=1，白底=0 */
   71          #define CTRL_DIV_1MS        10      /* Timer2为100us中断，10次执行一次控制≈1ms */
   72          
   73          #define BASE_PWM            62      /* 直道基础速度。画龙先降这个 */
   74          #define KP                  6       /* 比例：偏多少修多少。转弯不够就加大，修正太猛
             -就调小 */
   75          #define KD                  12      /* 微分：抑制过冲/阻尼。画龙就加大（治画龙主力�
